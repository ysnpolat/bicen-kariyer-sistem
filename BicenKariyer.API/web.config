<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS yapılandırması.

  Yayınlama sırasında bu dosya çıktı klasörüne kopyalanır ve
  processPath / arguments değerleri araç tarafından doldurulur.

  stdoutLogEnabled açıktır: uygulama açılışta çökerse sebebi
  apiservis\logs klasöründeki dosyalara yazılır. Bu olmadan IIS yalnızca
  "500 Internal Server Error" gösterir ve sebep görünmez.
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*"
             modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>

      <aspNetCore processPath="dotnet"
                  arguments=".\BicenKariyer.API.dll"
                  stdoutLogEnabled="true"
                  stdoutLogFile=".\logs\stdout"
                  hostingModel="inprocess">
        <environmentVariables>
          <!-- Açılış hatalarının ayrıntısı görünsün -->
          <environmentVariable name="ASPNETCORE_DETAILEDERRORS" value="true" />
        </environmentVariables>
      </aspNetCore>

      <!-- İstek boyutu sınırı: 500 MB (Program.cs BelgeSiniri ile aynı). Mesajlardaki
           büyük dosyalar 8 MB parçalarla geliyor, 5 GB'a kadar. -->
      <security>
        <requestFiltering>
          <requestLimits maxAllowedContentLength="524288000" />
        </requestFiltering>
      </security>
    </system.webServer>
  </location>
</configuration>
