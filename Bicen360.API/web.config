<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS yapılandırması.

  İki API aynı alan adı altında ayrı uygulama olarak yayınlanıyor:
      /apiservis    → BicenKariyer.API   (kendi havuzu, in-process)
      /portalservis → Bicen360.API       (bicen360 havuzu, out-of-process)

  AYRI HAVUZ ŞART
  Bir uygulama havuzu yalnızca TEK bir in-process ASP.NET Core uygulaması
  çalıştırabilir. İkisini aynı havuza koymak /apiservis'i durduruyor.

  <location> SARMALAYICISI YOK
  Kariyer API'sinde bu dosya <location path="." inheritInChildApplications=
  "false"> içine alınmış. "dotnet publish" o yapıyı dönüştürürken kök
  seviyeye processPath içermeyen ikinci bir aspNetCore elemanı ekliyor ve
  ANCM "Attribute 'processPath' is required" diyerek uygulamayı hiç
  başlatmıyor. Bu yüzden burada düz yapı kullanılıyor ve csproj içinde
  IsTransformWebConfigDisabled ile publish'in dosyaya karışması engellendi.

  hostingModel="outofprocess"
  ANCM ayrı bir dotnet.exe başlatıp isteği ona aktarıyor. Dinlenecek adresi
  ANCM belirlediği için appsettings.json içinde Kestrel:Endpoints tanımlı
  olmamalı; yerel geliştirmede port baslat.bat içinde urls parametresiyle veriliyor.

  requestTimeout="00:05:00"
  Out-of-process'te ANCM bir isteği varsayılan 2 dakika bekliyor, sonra 502
  veriyor. Uzun işler arka plana alındı; bu süre yalnızca güvenlik payı
  (12.10.2026).

  httpErrors VE requestFiltering YOK
  Bu iki bölüm IIS'te varsayılan olarak kilitli (overrideModeDefault="Deny").
  Uygulama düzeyinde tanımlanınca IIS yapılandırmayı hiç okuyamıyor ve
  500.19 veriyor — teşhis için eklenen ayar teşhisi engelliyordu.
  Fotoğraf boyutu için IIS'in 30 MB'lık varsayılanı yeterli.
-->
<configuration>
  <system.webServer>
    <handlers>
      <add name="aspNetCore" path="*" verb="*"
           modules="AspNetCoreModuleV2" resourceType="Unspecified" />
    </handlers>

    <aspNetCore processPath="dotnet"
                arguments=".\Bicen360.API.dll"
                stdoutLogEnabled="true"
                stdoutLogFile=".\logs\stdout"
                requestTimeout="00:05:00"
                hostingModel="outofprocess">
      <environmentVariables>
        <environmentVariable name="ASPNETCORE_DETAILEDERRORS" value="true" />
      </environmentVariables>
    </aspNetCore>

  </system.webServer>
</configuration>
