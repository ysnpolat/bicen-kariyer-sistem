<?xml version="1.0" encoding="utf-8"?>
<!--
  Portal tek sayfalık bir uygulama: bütün adresler index.html'e düşmeli.

  Bu dosya olmadan /portal/anasayfa adresine doğrudan girildiğinde ya da
  sayfa yenilendiğinde IIS diskte o adı arayıp 404 veriyor. Uygulama
  içinde gezinirken sorun görünmüyor çünkü adres tarayıcıda değişiyor ama
  sunucuya istek gitmiyor; hata yalnızca yenilemede ve paylaşılan
  bağlantıda ortaya çıkıyor.

  Yönlendirme hedefi /portal/index.html: uygulama alt dizinde sunuluyor ve
  köke yönlendirmek portalı değil ana siteyi açıyordu.
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="Portal SPA" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <!-- Gerçek dosya ve klasörler olduğu gibi sunulur -->
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
            <!-- Servis adresleri yönlendirilmez -->
            <add input="{REQUEST_URI}" pattern="^/(api|portalservis|apiservis)/" negate="true" />
          </conditions>
          <action type="Rewrite" url="/portal/index.html" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
