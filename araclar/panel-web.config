<?xml version="1.0" encoding="utf-8"?>
<!--
  Panel klasorleri icin yapilandirma.
  Iki yayinlama betigi de bu dosyayi kendi panel klasorune kopyalar:
  sunucu-yayinla.bat -> /panel (IK paneli)
  portal-yayinla.bat -> /portal (Bicen360)

  IP KISITLAMASI (onerilir):
  Paneli yalnizca ofis IP'nizden erisilebilir yapmak icin asagidaki
  <security><ipSecurity> blogundaki yorumu kaldirip IP adresinizi yaziniz.
  Bu ozellik icin IIS'te "IP and Domain Restrictions" bilesenin kurulu
  olmasi gerekir (Server Manager - Add Roles and Features - Web Server -
  Security - IP and Domain Restrictions).
-->
<configuration>
  <system.webServer>

    <httpProtocol>
      <customHeaders>
        <!-- Arama motorlarina kapat -->
        <add name="X-Robots-Tag" value="noindex, nofollow, noarchive" />
        <!-- Panelin baska sitelere gomulmesini engelle -->
        <add name="X-Frame-Options" value="SAMEORIGIN" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="Referrer-Policy" value="same-origin" />
      </customHeaders>
    </httpProtocol>

    <!--
    <security>
      <ipSecurity allowUnlisted="false" denyAction="NotFound">
        <add ipAddress="185.248.15.32" allowed="true" />
        <add ipAddress="127.0.0.1" allowed="true" />
      </ipSecurity>
    </security>
    -->

    <!-- PDF onizlemesinin calisani (pdf.js) .mjs uzantili; IIS bu uzantiyi
         varsayilan olarak tanimiyor ve dosyayi 404 ile reddediyordu. -->
    <staticContent>
      <remove fileExtension=".mjs" />
      <mimeMap fileExtension=".mjs" mimeType="text/javascript" />
    </staticContent>

    <defaultDocument>
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>

    <!--
      Tek sayfalik uygulama yonlendirmesi.

      Panel adresleri (/portal/anasayfa, /portal/raporlar ...) diskte
      karsiligi olmayan yollar. Bu kural olmadan sayfa yenilendiginde ya
      da baglanti paylasildiginda IIS o adi diskte arayip 404 veriyor.
      Uygulama icinde gezinirken sorun gorunmuyor: adres tarayicida
      degisiyor ama sunucuya istek gitmiyor.

      NOT: Bu kural icin IIS'te "URL Rewrite" bileseni kurulu olmalidir.
      Kurulu degilse IIS 500.19 hatasi verir; o durumda
      https://www.iis.net/downloads/microsoft/url-rewrite adresinden
      kurulabilir.
    -->
    <rewrite>
      <rules>
        <rule name="Panel SPA" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <!-- Gercek dosya ve klasorler oldugu gibi sunulur -->
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Rewrite" url="index.html" />
        </rule>
      </rules>
    </rewrite>

  </system.webServer>
</configuration>
