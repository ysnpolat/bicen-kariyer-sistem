<?xml version="1.0" encoding="utf-8"?>
<!--
  Biçen360 tek indirme bağlantısı: https://kariyer.bicen.com.tr/indir
  Arada sayfa yok. Sunucu isteği yapan cihazı tanıyıp doğrudan mağazaya
  yönlendiriyor (302):
    iPhone / iPad / iPod / Mac  -> App Store
    Android ve diğerleri        -> Google Play
  iPadOS kendini Mac olarak tanıttığı için Macintosh da App Store'a gidiyor.

  Mağaza bağlantısı değişirse yalnızca aşağıdaki iki "url" değeri güncellenir.
  IIS'te "URL Rewrite" bileşeni gerekir (panel için zaten kurulu).
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <clear />
        <rule name="Bicen360 App Store" stopProcessing="true">
          <match url=".*" />
          <conditions>
            <add input="{HTTP_USER_AGENT}" pattern="iPhone|iPad|iPod|Macintosh" />
          </conditions>
          <action type="Redirect" url="https://apps.apple.com/tr/app/id6810635909" redirectType="Found" appendQueryString="false" />
        </rule>
        <rule name="Bicen360 Google Play" stopProcessing="true">
          <match url=".*" />
          <action type="Redirect" url="https://play.google.com/store/apps/details?id=com.bicen.personel" redirectType="Found" appendQueryString="false" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
