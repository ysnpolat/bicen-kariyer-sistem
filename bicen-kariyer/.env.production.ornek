# ---------------------------------------------------------------------------
# Yayin derlemesi ayarlari  (bu dosyayi ".env.production" olarak kopyalayiniz)
# ---------------------------------------------------------------------------
#
# API, alan adi altinda /apiservis yolunda bir IIS uygulamasi olarak
# yayinlaniyorsa (bkz. plesk/IIS-API-KURULUM.md):
#
VITE_API_TABAN=https://kariyer.bicen.com.tr/apiservis
#
# API dogrudan /api yolundan (ters vekil ile) yayinlaniyorsa satiri
# tamamen bos birakiniz:
#
#   VITE_API_TABAN=
#
# API ayri bir alan adinda ise tam adresini yaziniz:
#
#   VITE_API_TABAN=https://api.bicen.com.tr
#
# Not: Sayfa https ile yayinlaniyorsa API de https olmalidir.
